# =============================================================================
# Alpha Pro MENA CRM — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=CHANGE_ME_TO_RANDOM_256BIT_SECRET
APP_DEBUG=true
FRONTEND_URL=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql+asyncpg://crm_user:crm_password@localhost:5432/alphaprocrm
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- JWT Authentication ---
JWT_SECRET_KEY=CHANGE_ME_TO_ANOTHER_RANDOM_256BIT_SECRET
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# --- Rate Limiting ---
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_DEFAULT=200/minute

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Google Sheets Integration (optional — leave blank to disable) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_PROJECT_ID=

# --- Background Jobs ---
JOB_OVERDUE_TASK_CHECK_MINUTES=5
JOB_GOOGLE_SHEETS_SYNC_MINUTES=15
JOB_RECALL_REMINDER_MINUTES=30
JOB_NOTIFICATION_CLEANUP_DAYS=30

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json              # json | text

# --- Admin Bootstrap (used in seed script only) ---
ADMIN_EMAIL=admin@alphapro.com
ADMIN_PASSWORD=CHANGE_ME_BEFORE_SEEDING
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
