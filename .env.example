# =============================================================================
# Alpha Pro MENA CRM — Environment Variables
# Local:  copy this file to backend/.env and fill in the values.
# Vercel: set the same keys in Project → Settings → Environment Variables.
# NEVER commit a real .env to version control.
# =============================================================================

# --- Application ---
APP_ENV=development            # development | staging | production | test
APP_SECRET_KEY=CHANGE_ME_TO_RANDOM_256BIT_SECRET      # >= 32 chars (enforced in production)
APP_DEBUG=true                 # exposes /api/docs — must be false in production
FRONTEND_URL=http://localhost:5173

# --- Database ---
# Local development (default): SQLite file inside backend/
DATABASE_URL=sqlite+aiosqlite:///./crm.db
# Production (required): PostgreSQL. Any of these forms are accepted and normalised:
#   postgresql://user:pass@host:5432/db?sslmode=require                 (Neon / Vercel Postgres)
#   postgres://user:pass@aws-0-eu-west-1.pooler.supabase.com:6543/postgres  (Supabase pooler)
# POSTGRES_URL (injected by Vercel storage integrations) is honoured as a fallback.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- JWT Authentication ---
JWT_SECRET_KEY=CHANGE_ME_TO_ANOTHER_RANDOM_256BIT_SECRET   # >= 32 chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# --- Rate Limiting (per client IP) ---
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_DEFAULT=200/minute

# --- CORS (comma separated; only needed when the frontend is on another origin) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Background Jobs ---
# ENABLE_SCHEDULER: leave unset to auto-detect (on locally / Docker, off on Vercel).
# ENABLE_SCHEDULER=true
# CRON_SECRET: required on Vercel — Vercel Cron calls /api/v1/jobs/run-all with
# "Authorization: Bearer <CRON_SECRET>". Generate with: openssl rand -hex 32
CRON_SECRET=
JOB_OVERDUE_TASK_CHECK_MINUTES=5
JOB_GOOGLE_SHEETS_SYNC_MINUTES=15
JOB_RECALL_REMINDER_MINUTES=30
JOB_NOTIFICATION_CLEANUP_DAYS=30

# --- Google Sheets Integration (optional — leave blank to disable) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_PROJECT_ID=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json                # json | text

# --- Admin Bootstrap (used by `python -m app.seed` only) ---
ADMIN_EMAIL=admin@alphapro.com
ADMIN_PASSWORD=                # leave blank to have a random one generated and printed
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
